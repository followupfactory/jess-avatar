# Jess Avatar Configuration

# Claude API (for Jess brain)
REACT_APP_CLAUDE_API_KEY=your_claude_api_key_here

# ElevenLabs (for voice)
REACT_APP_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
REACT_APP_ELEVENLABS_VOICE_ID=jess_voice_id

# HeyGen (for avatar video)
REACT_APP_HEYGEN_API_KEY=your_heygen_api_key_here
REACT_APP_HEYGEN_AVATAR_ID=jess_avatar_id

# GHL Webhook (for lead capture)
REACT_APP_GHL_WEBHOOK_URL=your_ghl_webhook_url_here

# Signup/Booking Link (where to redirect after qualifying)
REACT_APP_GHL_SIGNUP_LINK=https://your-ghl-booking-link.com
